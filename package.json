{
  "name": "stellar-forge",
  "version": "1.0.0",
  "private": true,
  "description": "A Stellar-native developer bounty & escrow marketplace. Fund software work in XLM/USDC held in a Soroban smart contract, released only when a GitHub-verified submission is approved.",
  "workspaces": [
    "packages/github",
    "packages/stellar"
  ],
  "scripts": {
    "test": "npm test -w @stellar-forge/github && npm test -w @stellar-forge/stellar",
    "test:contract": "cargo test --manifest-path contracts/bounty-escrow/Cargo.toml"
  },
  "keywords": [
    "stellar",
    "soroban",
    "bounty",
    "escrow",
    "marketplace",
    "smart-contracts",
    "usdc",
    "web3"
  ],
  "engines": {
    "node": ">=20"
  }
}
