# Stellar Agentic Framework — Environment Configuration
# Copy this to .env and fill in your values.

## Network Selection
STELLAR_NETWORK=testnet                    # testnet | mainnet | local
NEXT_PUBLIC_STELLAR_NETWORK=testnet        # Frontend (public, sent to browser)

## RPC Configuration
STELLAR_MAINNET_RPC_URL=                   # Required for mainnet. Get from RPC provider
NEXT_PUBLIC_STELLAR_MAINNET_RPC_URL=       # Frontend mainnet RPC URL

## Stellar Accounts
STELLAR_RECIPIENT=                         # G... address that receives payments
STELLAR_SECRET_KEY=                        # S... secret key for signing transactions

## x402 / OZ Channels
OZ_API_KEY=                                # Required for x402. Generate at channels.openzeppelin.com
FACILITATOR_URL=                           # Default: https://channels.openzeppelin.com/x402/testnet

## MPP
MPP_SECRET_KEY=                            # Shared secret for MPP credential verification
FEE_PAYER_SECRET=                          # S... secret for fee sponsorship (optional)
CHANNEL_CONTRACT=                          # C... contract address for MPP Channel mode
COMMITMENT_PUBKEY=                         # 64-char hex ed25519 public key for channel
COMMITMENT_SECRET=                         # 64-char hex ed25519 secret for channel client

## Deployed Contract Addresses (auto-populated by deploy)
# NEXT_PUBLIC_<CONTRACT_NAME>_CONTRACT_ID=<contract-id>
# Example:
# NEXT_PUBLIC_HELLO_WORLD_CONTRACT_ID=CA...
# NEXT_PUBLIC_TOKEN_CONTRACT_ID=CA...

## Deployment
VERCEL_TOKEN=                              # Vercel deploy token
VERCEL_ORG_ID=                             # Vercel organization ID

## Backend
PORT=3001                                  # Backend API port
BACKEND_URL=http://localhost:3001           # Backend URL for tests

## Stellar Wallet Kit (Frontend)
# NEXT_PUBLIC_* variables are exposed to the browser
