{
  "mcpServers": {
    "stellar-rpc": {
      "command": "npx",
      "args": ["@stellar/mcp-server"],
      "env": {
        "STELLAR_RPC_URL": {
          "description": "Stellar RPC endpoint. Defaults to testnet.",
          "default": "https://soroban-testnet.stellar.org"
        },
        "STELLAR_NETWORK_PASSPHRASE": {
          "description": "Network passphrase. Defaults to Test SDF Network ; September 2015",
          "default": "Test SDF Network ; September 2015"
        }
      }
    },
    "github": {
      "command": "npx",
      "args": ["@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": {
          "description": "GitHub personal access token"
        }
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "@modelcontextprotocol/server-filesystem",
        "/home/richie/Projects/stellar-forge"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": {
          "description": "Path to Playwright browsers",
          "default": "0"
        }
      }
    }
  }
}
